# Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only (Vercel env var, never exposed to the browser).
# Used by the click tracker, account deletion and staff creation.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Product name shown in the app (placeholder until the brand is final)
NEXT_PUBLIC_APP_NAME=MatchDay
